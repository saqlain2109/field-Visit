{
  "expo": {
    "name": "Field Visit CRM",
    "slug": "field-visit-crm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B4B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fieldvisit.crm",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Field Visit CRM requires location access to verify physical location and enforce workplace geo-fencing policies for visit and expense claim logging."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1B4B"
      },
      "package": "com.fieldvisit.crm",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Field Visit CRM requires location access to verify physical workplace presence during daily visit logging."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "caa99c39-8c46-4595-b1ba-355ba974f3d7"
      }
    },
    "owner": "saqlain_stuff"
  }
}
